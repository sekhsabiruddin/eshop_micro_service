{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Program (ts-node)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "-r",
        "ts-node/register",
        "-r",
        "tsconfig-paths/register"
      ],
      "args": ["${workspaceFolder}/apps/auth-service/src/main.ts"],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
